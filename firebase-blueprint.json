
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Extended profile information for the athlete including physical metrics and sport details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth ID." },
        "email": { "type": "string", "format": "email" },
        "sport": { "type": "string" },
        "position": { "type": "string" },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "age": { "type": "string" },
        "schoolStartTime": { "type": "string" },
        "schoolEndTime": { "type": "string" },
        "xp": { "type": "number", "description": "Total experience points earned." },
        "level": { "type": "number", "description": "Current athlete level." },
        "hasAccess": { "type": "boolean", "description": "Subscription status." },
        "bestAbilities": { "type": "array", "items": { "type": "string" } },
        "areaToImprove": { "type": "array", "items": { "type": "string" } },
        "completedActivities": { "type": "array", "items": { "type": "string" } },
        "dailyStats": {
          "type": "object",
          "properties": {
            "calories": { "type": "number" },
            "protein": { "type": "number" },
            "carbs": { "type": "number" },
            "fats": { "type": "number" },
            "sugar": { "type": "number" }
          }
        }
      },
      "required": ["uid", "email", "sport", "position"]
    },
    "TrainingPlan": {
      "title": "TrainingPlan",
      "description": "A daily AI-generated training plan for a specific athlete.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dailyFocusTitle": { "type": "string" },
        "schedule": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user athlete profiles."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": "TrainingPlan",
      "description": "Stores daily AI generated plans per user."
    }
  }
}
